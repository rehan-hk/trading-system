{
  "family": "trading-engine",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/trading-engine-task-role",
  "containerDefinitions": [
    {
      "name": "trading-engine",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/trading-engine:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [],
      "secrets": [
        {
          "name": "API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:trading-engine/api-key"
        },
        {
          "name": "API_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:trading-engine/api-secret"
        },
        {
          "name": "KITE_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:trading-engine/kite-username"
        },
        {
          "name": "KITE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:trading-engine/kite-password"
        },
        {
          "name": "TOTP_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:${AWS_ACCOUNT_ID}:secret:trading-engine/totp-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trading-engine",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 30
    }
  ]
}
